    <button class="asistente-fab" id="asistenteFab" onclick="toggleAsistente()">
        <i class="fas fa-robot"></i>
    </button>

    <div class="asistente-panel" id="asistentePanel">
        <div class="asistente-panel-header">
            <div>
                <h3>🤖 WalterBot</h3>
                <div class="sub">Creá clientes y registrá pagos</div>
            </div>
            <button onclick="toggleAsistente()"><i class="fas fa-times"></i></button>
        </div>
        <div class="asistente-chips">
            <div class="asistente-chip" onclick="asistenteSugerencia('Crear cliente nuevo')">Crear cliente</div>
            <div class="asistente-chip" onclick="asistenteSugerencia('Registrar una entrega')">Registrar entrega</div>
            <div class="asistente-chip" onclick="asistenteSugerencia('Pagar un fiado')">Pagar fiado</div>
            <div class="asistente-chip" onclick="asistenteSugerencia('cancelar')">Cancelar</div>
        </div>
        <div class="asistente-mensajes" id="asistenteMensajes"></div>
        <div class="asistente-input-row">
            <input type="text" id="asistenteInput" placeholder="Escribí o grabá un audio..." autocomplete="off">
            <button id="asistenteBtnMic" onclick="asistenteToggleGrabacion()" title="Enviar audio"><i class="fas fa-microphone"></i></button>
            <button id="asistenteBtnEnviar" onclick="asistenteEnviar()"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script>
        (function() {
            let asistenteAbierto = false;
            let asistenteInicializado = false;

            window.toggleAsistente = function() {
                asistenteAbierto = !asistenteAbierto;
                document.getElementById('asistentePanel').classList.toggle('abierto', asistenteAbierto);
                if (asistenteAbierto) {
                    document.getElementById('asistenteInput').focus();
                    if (!asistenteInicializado) {
                        asistenteInicializado = true;
                        asistenteAgregarMensaje('Hola 👋 Soy WalterBot, tu asistente. Contame lo que necesitás (crear un cliente, registrar una entrega o saldar un fiado) y lo resuelvo, aunque me lo digas todo junto.', 'bot');
                    }
                }
            };

            window.asistenteAgregarMensaje = function(texto, clase) {
                const cont = document.getElementById('asistenteMensajes');
                const div = document.createElement('div');
                div.className = 'asistente-msg ' + clase;
                div.textContent = texto;
                cont.appendChild(div);
                cont.scrollTop = cont.scrollHeight;
                return div;
            };

            window.asistenteSugerencia = function(texto) {
                document.getElementById('asistenteInput').value = texto;
                asistenteEnviar();
            };

            window.asistenteEnviar = async function() {
                const input = document.getElementById('asistenteInput');
                const btn = document.getElementById('asistenteBtnEnviar');
                const texto = input.value.trim();
                if (!texto) return;

                asistenteAgregarMensaje(texto, 'user');
                input.value = '';
                btn.disabled = true;
                const typingDiv = asistenteAgregarMensaje('Escribiendo...', 'bot typing');

                try {
                    const res = await fetch('/api/asistente/mensaje', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ mensaje: texto })
                    });
                    const data = await res.json();
                    typingDiv.remove();
                    asistenteAgregarMensaje(data.respuesta || 'No pude procesar el mensaje.', 'bot');
                } catch (e) {
                    typingDiv.remove();
                    asistenteAgregarMensaje('Error de conexión. Probá de nuevo.', 'bot');
                } finally {
                    btn.disabled = false;
                    input.focus();
                }
            };

            // ── Grabación y envío de audio ───────────────────────────────────
            let asistenteMediaRecorder = null;
            let asistenteAudioChunks = [];
            let asistenteGrabando = false;

            window.asistenteToggleGrabacion = async function() {
                if (asistenteGrabando) {
                    asistenteMediaRecorder.stop();
                    return;
                }

                if (!navigator.mediaDevices || !window.MediaRecorder) {
                    asistenteAgregarMensaje('Tu navegador no permite grabar audio. Probá escribiendo el mensaje.', 'bot');
                    return;
                }

                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    asistenteAudioChunks = [];
                    asistenteMediaRecorder = new MediaRecorder(stream);

                    asistenteMediaRecorder.ondataavailable = function(e) {
                        if (e.data && e.data.size > 0) asistenteAudioChunks.push(e.data);
                    };

                    asistenteMediaRecorder.onstop = async function() {
                        stream.getTracks().forEach(t => t.stop());
                        document.getElementById('asistenteBtnMic').classList.remove('grabando');
                        asistenteGrabando = false;
                        const blob = new Blob(asistenteAudioChunks, { type: 'audio/webm' });
                        if (blob.size > 0) await asistenteEnviarAudio(blob);
                    };

                    asistenteMediaRecorder.start();
                    asistenteGrabando = true;
                    document.getElementById('asistenteBtnMic').classList.add('grabando');
                } catch (e) {
                    asistenteAgregarMensaje('No pude acceder al micrófono. Revisá los permisos del navegador.', 'bot');
                }
            };

            window.asistenteEnviarAudio = async function(blob) {
                const btnEnviar = document.getElementById('asistenteBtnEnviar');
                const btnMic = document.getElementById('asistenteBtnMic');
                btnEnviar.disabled = true;
                btnMic.disabled = true;
                const typingDiv = asistenteAgregarMensaje('Escuchando el audio...', 'bot typing');

                try {
                    const formData = new FormData();
                    formData.append('audio', blob, 'audio.webm');
                    const res = await fetch('/api/asistente/audio', { method: 'POST', body: formData });
                    const data = await res.json();
                    typingDiv.remove();
                    if (data.transcripcion) {
                        asistenteAgregarMensaje(data.transcripcion, 'user');
                    }
                    asistenteAgregarMensaje(data.respuesta || 'No pude procesar el audio.', 'bot');
                } catch (e) {
                    typingDiv.remove();
                    asistenteAgregarMensaje('Error de conexión al enviar el audio.', 'bot');
                } finally {
                    btnEnviar.disabled = false;
                    btnMic.disabled = false;
                }
            };

            document.addEventListener('DOMContentLoaded', function() {
                const input = document.getElementById('asistenteInput');
                if (input) {
                    input.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') asistenteEnviar();
                    });
                }
            });
        })();
    </script>
</body> 
