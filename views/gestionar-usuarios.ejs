<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionar Usuarios</title>
    <link rel="stylesheet" href="/public/css/index.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/css/alertify.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/css/themes/default.min.css"/>
    <style>
        :root {
            --admin-blue: rgb(0, 0, 128);
            --admin-danger: #d9534f;
            --admin-success: #5cb85c;
            --admin-warning: #f0ad4e;
            --admin-muted: #6c757d;
        }

        .main-container {
            padding: 40px 20px;
            max-width: 1200px;
            margin: 0 auto;
            min-height: 100vh;
            justify-content: flex-start;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        /* Tabs */
        .tabs {
            display: flex;
            gap: 0;
            border-bottom: 2px solid #ddd;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .tab-btn {
            padding: 10px 22px;
            border: none;
            background: none;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            color: var(--admin-muted);
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .tab-btn.active {
            color: var(--admin-blue);
            border-bottom-color: var(--admin-blue);
        }

        .tab-badge {
            background: var(--admin-blue);
            color: white;
            border-radius: 10px;
            padding: 1px 7px;
            font-size: 12px;
        }

        .tab-badge.danger  { background: var(--admin-danger); }
        .tab-badge.warning { background: var(--admin-warning); color: #333; }

        .tab-section         { display: none; }
        .tab-section.active  { display: block; }

        /* Buscador */
        .search-bar {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            max-width: 400px;
        }

        .search-bar input {
            flex: 1;
            padding: 9px 15px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

        .search-bar input:focus { border-color: var(--admin-blue); }

        /* Cards grid */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .user-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border: 1px solid #e8e8e8;
            border-top: 4px solid var(--admin-blue);
            transition: transform 0.2s, box-shadow 0.2s;
            position: relative;
        }

        .user-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(0,0,0,0.13);
        }

        .user-card.bloqueado { border-top-color: var(--admin-danger); background: #fff8f8; }
        .user-card.pendiente { border-top-color: var(--admin-warning); }
        .user-card.rechazado { border-top-color: var(--admin-muted); }

        .user-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--admin-blue), #1a1aff);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .user-card.bloqueado .user-avatar { background: linear-gradient(135deg, var(--admin-danger), #c0392b); }

        .user-name  { font-size: 16px; font-weight: 700; color: #222; margin-bottom: 4px; }
        .user-email { font-size: 13px; color: #666; margin-bottom: 4px; word-break: break-all; }

        .user-role {
            display: inline-block;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 9px;
            border-radius: 10px;
            background: #e8eaf6;
            color: var(--admin-blue);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 12px;
            margin-top: 6px;
        }

        .status-badge.activo    { background: #e8f5e9; color: #388e3c; }
        .status-badge.bloqueado { background: #ffebee; color: var(--admin-danger); }
        .status-badge.pendiente { background: #fff8e1; color: #f57c00; }
        .status-badge.rechazado { background: #f5f5f5; color: #757575; }

        .btn-group {
            display: flex;
            gap: 8px;
            margin-top: 16px;
            flex-wrap: wrap;
        }

        .btn-action {
            flex: 1;
            min-width: 90px;
            padding: 9px 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-action:hover { opacity: 0.88; transform: translateY(-1px); }

        .btn-bloquear    { background: var(--admin-danger);  color: white; }
        .btn-desbloquear { background: var(--admin-success); color: white; }
        .btn-accept      { background: var(--admin-blue);    color: white; }
        .btn-reject      { background: #f5f5f5; color: var(--admin-danger); border: 1px solid var(--admin-danger); }
        .btn-recover     { background: var(--admin-success); color: white; }
        .btn-delete      { background: #fff; color: var(--admin-danger); border: 1px solid var(--admin-danger); font-size: 12px; }

        .empty-state { text-align: center; padding: 50px 20px; color: #aaa; }
        .empty-state i { font-size: 48px; margin-bottom: 12px; display: block; }

        /* Stats */
        .stats-row {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .stat-card {
            background: white;
            border-radius: 8px;
            padding: 16px 22px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.07);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 140px;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: white;
        }

        .stat-icon.blue   { background: var(--admin-blue); }
        .stat-icon.green  { background: var(--admin-success); }
        .stat-icon.red    { background: var(--admin-danger); }
        .stat-icon.yellow { background: var(--admin-warning); }

        .stat-info .stat-num   { font-size: 22px; font-weight: 700; color: #222; }
        .stat-info .stat-label { font-size: 12px; color: #888; }
    </style>
</head>
<body>
    <header>
        <div class="menu-icon">
            <div class="menu-icon-bar"></div>
            <div class="menu-icon-bar"></div>
            <div class="menu-icon-bar"></div>
        </div>
        <nav class="nav-menu">
            <a href="/home">Inicio</a>
            <a href="/historial/cuentas">historial</a>
            <a href="/notas">notas</a>
            <a href="/chat/grupal" class="chat-link">
                chat
                <% if (typeof usuarioId !== 'undefined' && usuarioId) { %>
                    <span class="badge-unread" id="chatBadge" style="display: none;">0</span>
                <% } %>
            </a>
            <a href="/configuracion" class="admin-link">configuración</a>
            <% if (typeof usuarioRol !== 'undefined' && usuarioRol === 'admin') { %>
                <a href="/admin/invitaciones" class="admin-link">Invitaciones</a>
                <a href="/admin/usuarios" class="admin-link">Usuarios</a>
            <% } %>
        </nav>
        <div class="registroinicio">
            <% if (nombreUsuario) { %>
                <span><%= nombreUsuario %></span>
                <a href="/logout">Cerrar sesión</a>
            <% } else { %>
                <a href="/login">Iniciar sesión</a>
                <a href="/registro">Crear cuenta</a>
            <% } %>
        </div>
    </header>

    <main class="main-container">

        <% if (typeof flash !== 'undefined' && flash) { %>
            <div id="flashData" data-type="<%= flash.tipo %>" data-msg="<%= flash.mensaje %>"></div>
        <% } %>

        <div class="page-header">
            <h1 class="main-title"><i class="fas fa-users-cog"></i> Gestionar Usuarios</h1>
        </div>

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="fas fa-users"></i></div>
                <div class="stat-info">
                    <div class="stat-num"><%= totalUsuarios %></div>
                    <div class="stat-label">Total usuarios</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="fas fa-user-check"></i></div>
                <div class="stat-info">
                    <div class="stat-num"><%= usuariosActivos %></div>
                    <div class="stat-label">Activos</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon red"><i class="fas fa-user-slash"></i></div>
                <div class="stat-info">
                    <div class="stat-num"><%= usuariosBloqueados %></div>
                    <div class="stat-label">Bloqueados</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon yellow"><i class="fas fa-user-clock"></i></div>
                <div class="stat-info">
                    <div class="stat-num"><%= usuariosPendientes.length %></div>
                    <div class="stat-label">Pendientes</div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs">
            <button class="tab-btn active" onclick="mostrarTab('todos', this)">
                <i class="fas fa-list"></i> Todos
                <span class="tab-badge"><%= totalUsuarios %></span>
            </button>
            <button class="tab-btn" onclick="mostrarTab('pendientes', this)">
                <i class="fas fa-clock"></i> Pendientes
                <% if (usuariosPendientes.length > 0) { %>
                    <span class="tab-badge warning"><%= usuariosPendientes.length %></span>
                <% } %>
            </button>
            <button class="tab-btn" onclick="mostrarTab('bloqueados', this)">
                <i class="fas fa-ban"></i> Bloqueados
                <% if (usuariosBloqueados > 0) { %>
                    <span class="tab-badge danger"><%= usuariosBloqueados %></span>
                <% } %>
            </button>
        </div>

        <!-- TAB: TODOS -->
        <div id="tab-todos" class="tab-section active">
            <div class="search-bar">
                <input type="text" id="buscarTodos" placeholder="Buscar por nombre o email..." oninput="filtrarTarjetas('todos')">
            </div>
            <% if (todosLosUsuarios && todosLosUsuarios.length > 0) { %>
                <div class="cards-grid" id="grid-todos">
                    <% todosLosUsuarios.forEach(u => { %>
                        <div class="user-card <%= u.rol === 'admin' ? '' : (u.estado_permiso === 'bloqueado' ? 'bloqueado' : (u.estado_permiso === 'pendiente' ? 'pendiente' : '')) %>"
                             data-nombre="<%= u.nombre.toLowerCase() %>"
                             data-email="<%= u.gmail.toLowerCase() %>">
                            <div class="user-avatar"><%= u.nombre.charAt(0).toUpperCase() %></div>
                            <div class="user-name"><%= u.nombre %></div>
                            <div class="user-email"><i class="fas fa-envelope" style="color:#aaa;margin-right:4px;"></i><%= u.gmail %></div>
                            <span class="user-role"><%= u.rol %></span><br>
                            <%
                                let estadoLabel, estadoClass;
                                if (u.rol === 'admin') {
                                    estadoLabel = 'Administrador'; estadoClass = 'activo';
                                } else if (u.estado_permiso === 'bloqueado') {
                                    estadoLabel = 'Bloqueado';  estadoClass = 'bloqueado';
                                } else if (u.estado_permiso === 'pendiente') {
                                    estadoLabel = 'Pendiente';  estadoClass = 'pendiente';
                                } else if (u.estado_permiso === 'rechazado') {
                                    estadoLabel = 'Rechazado';  estadoClass = 'rechazado';
                                } else {
                                    estadoLabel = 'Activo';     estadoClass = 'activo';
                                }
                            %>
                            <span class="status-badge <%= estadoClass %>">
                                <i class="fas fa-circle" style="font-size:8px;"></i> <%= estadoLabel %>
                            </span>

                            <% if (u.rol !== 'admin') { %>
                                <div class="btn-group">
                                    <% if (u.estado_permiso === 'bloqueado') { %>
                                        <button class="btn-action btn-desbloquear"
                                            onclick="confirmarAccion('desbloquear', '<%= u.id %>', '<%= u.nombre %>')">
                                            <i class="fas fa-unlock"></i> Desbloquear
                                        </button>
                                    <% } else if (u.estado_permiso === 'pendiente') { %>
                                        <button class="btn-action btn-accept"
                                            onclick="confirmarAccion('aceptar', '<%= u.id %>', '<%= u.nombre %>')">
                                            <i class="fas fa-check"></i> Aceptar
                                        </button>
                                        <button class="btn-action btn-reject"
                                            onclick="confirmarAccion('rechazar', '<%= u.id %>', '<%= u.nombre %>')">
                                            <i class="fas fa-times"></i> Rechazar
                                        </button>
                                    <% } else { %>
                                        <button class="btn-action btn-bloquear"
                                            onclick="confirmarAccion('bloquear', '<%= u.id %>', '<%= u.nombre %>')">
                                            <i class="fas fa-ban"></i> Bloquear
                                        </button>
                                    <% } %>
                                    <button class="btn-action btn-delete"
                                        onclick="confirmarEliminar('<%= u.id %>', '<%= u.nombre %>')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            <% } else { %>
                                <div style="margin-top:16px;font-size:12px;color:#aaa;">
                                    <i class="fas fa-shield-alt"></i> Cuenta de administrador
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-users"></i>
                    No hay usuarios registrados.
                </div>
            <% } %>
        </div>

        <!-- TAB: PENDIENTES -->
        <div id="tab-pendientes" class="tab-section">
            <% if (usuariosPendientes && usuariosPendientes.length > 0) { %>
                <div class="cards-grid">
                    <% usuariosPendientes.forEach(u => { %>
                        <div class="user-card pendiente">
                            <div class="user-avatar" style="background:linear-gradient(135deg,#f0ad4e,#e67e22)"><%= u.nombre.charAt(0).toUpperCase() %></div>
                            <div class="user-name"><%= u.nombre %></div>
                            <div class="user-email"><i class="fas fa-envelope" style="color:#aaa;margin-right:4px;"></i><%= u.gmail %></div>
                            <span class="status-badge pendiente"><i class="fas fa-circle" style="font-size:8px;"></i> Pendiente de aprobación</span>
                            <div class="btn-group">
                                <button class="btn-action btn-accept"
                                    onclick="confirmarAccion('aceptar', '<%= u.id %>', '<%= u.nombre %>')">
                                    <i class="fas fa-check"></i> Aceptar
                                </button>
                                <button class="btn-action btn-reject"
                                    onclick="confirmarAccion('rechazar', '<%= u.id %>', '<%= u.nombre %>')">
                                    <i class="fas fa-times"></i> Rechazar
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-user-clock"></i>
                    No hay usuarios pendientes de aprobación.
                </div>
            <% } %>
        </div>

        <!-- TAB: BLOQUEADOS -->
        <div id="tab-bloqueados" class="tab-section">
            <% if (usuariosBloqueadosList && usuariosBloqueadosList.length > 0) { %>
                <div class="cards-grid">
                    <% usuariosBloqueadosList.forEach(u => { %>
                        <div class="user-card bloqueado">
                            <div class="user-avatar"><%= u.nombre.charAt(0).toUpperCase() %></div>
                            <div class="user-name"><%= u.nombre %></div>
                            <div class="user-email"><i class="fas fa-envelope" style="color:#aaa;margin-right:4px;"></i><%= u.gmail %></div>
                            <span class="status-badge bloqueado"><i class="fas fa-ban" style="font-size:9px;"></i> Bloqueado</span>
                            <div class="btn-group">
                                <button class="btn-action btn-desbloquear"
                                    onclick="confirmarAccion('desbloquear', '<%= u.id %>', '<%= u.nombre %>')">
                                    <i class="fas fa-unlock"></i> Desbloquear
                                </button>
                                <button class="btn-action btn-delete"
                                    onclick="confirmarEliminar('<%= u.id %>', '<%= u.nombre %>')">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-user-slash"></i>
                    No hay usuarios bloqueados.
                </div>
            <% } %>
        </div>

    </main>

    <form id="formAccion" method="POST" style="display:none;">
        <input type="hidden" name="_accion" id="inputAccion">
    </form>

    <script src="https://cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/alertify.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        alertify.defaults.transition = "slide";

        document.addEventListener('DOMContentLoaded', function() {
            const flash = document.getElementById('flashData');
            if (flash) {
                const tipo = flash.dataset.type;
                const msg  = flash.dataset.msg;
                if (msg) {
                    if (tipo === 'success')      alertify.success(msg);
                    else if (tipo === 'error')   alertify.error(msg);
                    else if (tipo === 'warning') alertify.warning(msg);
                    else                         alertify.message(msg);
                }
            }
        });

        function mostrarTab(nombre, btn) {
            document.querySelectorAll('.tab-section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + nombre).classList.add('active');
            btn.classList.add('active');
        }

        function filtrarTarjetas(tab) {
            const query   = document.getElementById('buscar' + tab.charAt(0).toUpperCase() + tab.slice(1)).value.toLowerCase();
            const tarjetas = document.querySelectorAll('#grid-' + tab + ' .user-card');
            tarjetas.forEach(card => {
                const nombre = card.dataset.nombre || '';
                const email  = card.dataset.email  || '';
                card.style.display = (nombre.includes(query) || email.includes(query)) ? '' : 'none';
            });
        }

        function confirmarAccion(accion, usuarioId, nombre) {
            const mensajes = {
                bloquear:    `¿Bloquear a <strong>${nombre}</strong>? No podrá iniciar sesión.`,
                desbloquear: `¿Desbloquear a <strong>${nombre}</strong>? Recuperará el acceso.`,
                aceptar:     `¿Aprobar la cuenta de <strong>${nombre}</strong>?`,
                rechazar:    `¿Rechazar la solicitud de <strong>${nombre}</strong>?`
            };
            const rutas = {
                bloquear:    `/admin/bloquear-usuario/${usuarioId}`,
                desbloquear: `/admin/desbloquear-usuario/${usuarioId}`,
                aceptar:     `/admin/aceptar-usuario/${usuarioId}`,
                rechazar:    `/admin/rechazar-usuario/${usuarioId}`
            };
            alertify.confirm(
                'Confirmar acción',
                mensajes[accion],
                function() {
                    const form = document.getElementById('formAccion');
                    form.action = rutas[accion];
                    form.submit();
                },
                function() { alertify.warning('Acción cancelada.'); }
            ).set('labels', { ok: 'Confirmar', cancel: 'Cancelar' });
        }

        function confirmarEliminar(usuarioId, nombre) {
            alertify.confirm(
                '⚠️ Eliminar usuario',
                `¿Estás seguro de que querés eliminar a <strong>${nombre}</strong> permanentemente? Esta acción no se puede deshacer.`,
                function() {
                    const form = document.getElementById('formAccion');
                    form.action = `/admin/eliminar-usuario/${usuarioId}`;
                    form.submit();
                },
                function() { alertify.warning('Eliminación cancelada.'); }
            ).set('labels', { ok: '🗑️ Eliminar', cancel: 'Cancelar' });
        }

        // Menú hamburguesa — igual que index.ejs
        const menuIcon = document.querySelector('.menu-icon');
        const navMenu  = document.querySelector('.nav-menu');
        menuIcon.addEventListener('click', () => navMenu.classList.toggle('show'));

        // Badge chat
        <% if (typeof usuarioId !== 'undefined' && usuarioId) { %>
        (function() {
            const socket = io();
            async function actualizarBadge() {
                try {
                    const res   = await fetch('/api/no-leidos');
                    const map   = await res.json();
                    const total = Object.values(map).reduce((a, v) => a + v, 0);
                    const badge = document.getElementById('chatBadge');
                    if (badge) { badge.textContent = total; badge.style.display = total > 0 ? 'inline' : 'none'; }
                } catch(e) {}
            }
            socket.on('update-unread', actualizarBadge);
            document.addEventListener('DOMContentLoaded', actualizarBadge);
        })();
        <% } %>
    </script>
</body>
</html>
