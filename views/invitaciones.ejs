<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invitaciones</title>
    <link rel="stylesheet" href="/public/css/index.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/css/alertify.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/css/themes/default.min.css"/>
    <style>
        :root {
            --admin-blue: rgb(0, 0, 128);
            --admin-danger: #d9534f;
            --admin-success: #5cb85c;
        }

        .main-container {
            padding: 40px 20px;
            max-width: 1200px;
            margin: 0 auto;
            min-height: 100vh;
            justify-content: flex-start;
        }

        .section-title {
            font-size: 22px;
            color: #444;
            margin: 35px 0 18px;
            text-align: left;
            border-left: 5px solid var(--admin-blue);
            padding-left: 15px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            width: 100%;
        }

        .user-card-modern {
            background: white;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border: 1px solid #ddd;
            border-top: 4px solid var(--admin-blue);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .user-card-modern:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.2);
        }

        .user-card-modern p { margin: 8px 0; font-size: 15px; }

        .btn-group-modern { display: flex; gap: 10px; margin-top: 15px; }

        .btn-modern {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-modern:hover { opacity: 0.85; transform: translateY(-1px); }

        .btn-accept  { background-color: var(--admin-blue); color: white; }
        .btn-reject  { background-color: #f1f1f1; color: var(--admin-danger); border: 1px solid var(--admin-danger); }
        .btn-recover { background-color: var(--admin-success); color: white; width: 100%; }

        .no-clientes { color: #aaa; text-align: center; padding: 30px; font-size: 15px; }

        .admin-links-bar {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .admin-link-btn {
            padding: 9px 18px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: 0.2s;
        }

        .admin-link-btn.active  { background: var(--admin-blue); color: white; }
        .admin-link-btn.outline { background: white; color: var(--admin-blue); border: 1.5px solid var(--admin-blue); }
        .admin-link-btn:hover   { opacity: 0.85; }
    </style>
</head>
<body>
    <header>
        <div class="menu-icon">
            <div class="menu-icon-bar"></div>
            <div class="menu-icon-bar"></div>
            <div class="menu-icon-bar"></div>
        </div>
        <nav class="nav-menu">
            <a href="/home">Inicio</a>
            <a href="/historial/cuentas">historial</a>
            <a href="/notas">notas</a>
            <a href="/chat/grupal" class="chat-link">
                chat                                              
                <% if (typeof usuarioId !== 'undefined' && usuarioId) { %>
                    <span class="badge-unread" id="chatBadge" style="display: none;">0</span>
                <% } %>
            </a>
            <a href="/configuracion" class="admin-link">configuración</a>
            <% if (typeof usuarioRol !== 'undefined' && usuarioRol === 'admin') { %>
                <a href="/admin/invitaciones" class="admin-link">Invitaciones</a>
            <% } %>
        </nav>
        <div class="registroinicio">
            <% if (nombreUsuario) { %>
                <span><%= nombreUsuario %></span>
                <a href="/logout">Cerrar sesión</a>
            <% } else { %>
                <a href="/login">Iniciar sesión</a>
                <a href="/registro">Crear cuenta</a>
            <% } %>
        </div>
    </header>

    <main class="main-container">

        <% if (typeof flash !== 'undefined' && flash) { %>
            <div id="flashData" data-type="<%= flash.tipo %>" data-msg="<%= flash.mensaje %>"></div>
        <% } %>

        <h1 class="main-title">Gestión de Usuarios</h1>

        <div class="admin-links-bar">
            <a href="/admin/invitaciones" class="admin-link-btn active">
                <i class="fas fa-envelope"></i> Invitaciones
            </a>
            <a href="/admin/usuarios" class="admin-link-btn outline">
                <i class="fas fa-users-cog"></i> Gestionar todos
            </a>
        </div>

        <h2 class="section-title">Pendientes</h2>
        <% if (usuariosPendientes && usuariosPendientes.length > 0) { %>
            <div class="cards-grid">
                <% usuariosPendientes.forEach(u => { %>
                    <div class="user-card-modern">
                        <p><strong><i class="fas fa-user"></i> Nombre:</strong> <%= u.nombre %></p>
                        <p><strong><i class="fas fa-envelope"></i> Email:</strong> <%= u.gmail %></p>
                        <div class="btn-group-modern">
                            <button type="button" class="btn-modern btn-accept"
                                onclick="confirmarInvitacion('aceptar', '<%= u.id %>', '<%= u.nombre %>')">
                                <i class="fas fa-check"></i> Aceptar
                            </button>
                            <button type="button" class="btn-modern btn-reject"
                                onclick="confirmarInvitacion('rechazar', '<%= u.id %>', '<%= u.nombre %>')">
                                <i class="fas fa-times"></i> Rechazar
                            </button>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="no-clientes"><i class="fas fa-check-circle" style="color:#5cb85c;margin-right:6px;"></i>No hay invitaciones pendientes.</p>
        <% } %>

        <h2 class="section-title" style="border-color: var(--admin-danger); color: var(--admin-danger);">Rechazados</h2>
        <% if (usuariosRechazados && usuariosRechazados.length > 0) { %>
            <div class="cards-grid">
                <% usuariosRechazados.forEach(u => { %>
                    <div class="user-card-modern" style="border-top-color: var(--admin-danger);">
                        <p><strong>Nombre:</strong> <%= u.nombre %></p>
                        <p><strong>Email:</strong> <%= u.gmail %></p>
                        <button type="button" class="btn-modern btn-recover" style="margin-top:15px;"
                            onclick="confirmarInvitacion('re-admitir', '<%= u.id %>', '<%= u.nombre %>')">
                            <i class="fas fa-undo"></i> Restaurar Acceso
                        </button>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="no-clientes">No hay historial de rechazados.</p>
        <% } %>

    </main>

    <form id="formInvitacion" method="POST" style="display:none;"></form>

    <script src="https://cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/alertify.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        alertify.defaults.transition = "slide";

        document.addEventListener('DOMContentLoaded', function() {
            const flash = document.getElementById('flashData');
            if (flash) {
                const tipo = flash.dataset.type;
                const msg  = flash.dataset.msg;
                if (msg) {
                    if (tipo === 'success')    alertify.success(msg);
                    else if (tipo === 'error') alertify.error(msg);
                    else                       alertify.message(msg);
                }
            }
        });

        function confirmarInvitacion(accion, usuarioId, nombre) {
            const rutas = {
                'aceptar':    `/admin/aceptar-usuario/${usuarioId}`,
                'rechazar':   `/admin/rechazar-usuario/${usuarioId}`,
                're-admitir': `/admin/aceptar-usuario/${usuarioId}`
            };
            const mensajes = {
                'aceptar':    `¿Aceptar la solicitud de <strong>${nombre}</strong>?`,
                'rechazar':   `¿Rechazar la solicitud de <strong>${nombre}</strong>?`,
                're-admitir': `¿Restaurar el acceso de <strong>${nombre}</strong>?`
            };
            alertify.confirm(
                'Confirmar',
                mensajes[accion],
                function() {
                    const form = document.getElementById('formInvitacion');
                    form.action = rutas[accion];
                    form.submit();
                },
                function() { alertify.warning('Acción cancelada.'); }
            ).set('labels', { ok: 'Confirmar', cancel: 'Cancelar' });
        }

        // Menú hamburguesa — igual que index.ejs
        const menuIcon = document.querySelector('.menu-icon');
        const navMenu  = document.querySelector('.nav-menu');
        menuIcon.addEventListener('click', () => navMenu.classList.toggle('show'));

        // Badge chat
        <% if (typeof usuarioId !== 'undefined' && usuarioId) { %>
        (function() {
            const socket = io();
            async function actualizarBadge() {
                try {
                    const res   = await fetch('/api/no-leidos');
                    const map   = await res.json();
                    const total = Object.values(map).reduce((a, v) => a + v, 0);
                    const badge = document.getElementById('chatBadge');
                    if (badge) { badge.textContent = total; badge.style.display = total > 0 ? 'inline' : 'none'; }
                } catch(e) {}
            }
            socket.on('update-unread', actualizarBadge);
            document.addEventListener('DOMContentLoaded', actualizarBadge);
        })();
        <% } %>
    </script>
</body>
</html>