<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asistente - Agua Upsala</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #eef1f5;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .asistente-header {
            background: #1565c0;
            color: white;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        }

        .asistente-header a {
            color: white;
            text-decoration: none;
            font-size: 1.2rem;
        }

        .asistente-header h1 {
            font-size: 1.1rem;
            font-weight: 600;
        }

        .asistente-header .subtitulo {
            font-size: 0.75rem;
            opacity: 0.85;
        }

        .chat-area {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .msg {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 14px;
            line-height: 1.4;
            white-space: pre-wrap;
            font-size: 0.95rem;
        }

        .msg.bot {
            background: white;
            align-self: flex-start;
            border-bottom-left-radius: 4px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.08);
        }

        .msg.user {
            background: #1565c0;
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }

        .msg.typing {
            font-style: italic;
            color: #888;
            background: white;
        }

        .sugerencias {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 0 16px 10px;
        }

        .chip {
            background: white;
            border: 1px solid #1565c0;
            color: #1565c0;
            border-radius: 20px;
            padding: 6px 12px;
            font-size: 0.8rem;
            cursor: pointer;
            white-space: nowrap;
        }

        .chip:hover {
            background: #1565c0;
            color: white;
        }

        .input-area {
            display: flex;
            gap: 8px;
            padding: 12px;
            background: white;
            border-top: 1px solid #ddd;
        }

        .input-area input {
            flex: 1;
            border: 1px solid #ccc;
            border-radius: 24px;
            padding: 10px 16px;
            font-size: 0.95rem;
            outline: none;
        }

        .input-area input:focus {
            border-color: #1565c0;
        }

        .input-area button {
            background: #1565c0;
            color: white;
            border: none;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .input-area button:disabled {
            opacity: 0.6;
            cursor: default;
        }
    </style>
</head>
<body data-nombre="<%= nombreUsuario %>">
    <div class="asistente-header">
        <a href="/home"><i class="fas fa-arrow-left"></i></a>
        <div>
            <h1>🤖 Asistente</h1>
            <div class="subtitulo">Creá clientes y registrá pagos escribiendo</div>
        </div>
    </div>

    <div class="sugerencias" id="sugerencias">
        <div class="chip" onclick="enviarSugerencia('Crear cliente nuevo')">Crear cliente</div>
        <div class="chip" onclick="enviarSugerencia('Registrar una entrega')">Registrar entrega</div>
        <div class="chip" onclick="enviarSugerencia('Pagar un fiado')">Pagar un fiado</div>
        <div class="chip" onclick="enviarSugerencia('cancelar')">Cancelar</div>
    </div>

    <div class="chat-area" id="chatArea"></div>

    <div class="input-area">
        <input type="text" id="mensajeInput" placeholder="Escribí acá..." autocomplete="off">
        <button id="btnEnviar" onclick="enviarMensaje()"><i class="fas fa-paper-plane"></i></button>
    </div>

    <script>
        const chatArea = document.getElementById('chatArea');
        const input = document.getElementById('mensajeInput');
        const btnEnviar = document.getElementById('btnEnviar');

        function agregarMensaje(texto, clase) {
            const div = document.createElement('div');
            div.className = 'msg ' + clase;
            div.textContent = texto;
            chatArea.appendChild(div);
            chatArea.scrollTop = chatArea.scrollHeight;
            return div;
        }

        function enviarSugerencia(texto) {
            input.value = texto;
            enviarMensaje();
        }

        async function enviarMensaje() {
            const texto = input.value.trim();
            if (!texto) return;

            agregarMensaje(texto, 'user');
            input.value = '';
            input.focus();
            btnEnviar.disabled = true;

            const typingDiv = agregarMensaje('Escribiendo...', 'bot typing');

            try {
                const res = await fetch('/api/asistente/mensaje', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mensaje: texto })
                });
                const data = await res.json();
                typingDiv.remove();
                agregarMensaje(data.respuesta || 'No pude procesar el mensaje.', 'bot');
            } catch (e) {
                typingDiv.remove();
                agregarMensaje('Error de conexión. Probá de nuevo.', 'bot');
            } finally {
                btnEnviar.disabled = false;
            }
        }

        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') enviarMensaje();
        });

        // Mensaje de bienvenida
        const nombreUsuario = document.body.dataset.nombre || '';
        agregarMensaje(
            `Hola ${nombreUsuario} 👋 Soy tu asistente. Puedo crear clientes y registrar pagos, fiados o transferencias. ¿Qué necesitás?`,
            'bot'
        );
    </script>
</body>
</html>